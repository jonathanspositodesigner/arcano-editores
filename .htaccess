AddType application/wasm .wasm
AddType text/javascript .js
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE application/wasm text/javascript text/html
</IfModule>

# Código-fonte e configuração não são públicos.
RedirectMatch 404 ^/(conector|patches|desktop|\.github)(/|$)
RedirectMatch 404 ^/versoes\.env$

# A hospedagem põe "Content-Security-Policy: upgrade-insecure-requests", que troca o
# http://127.0.0.1 do Arcano Conector por https e o painel nunca acha o conector.
<IfModule mod_headers.c>
Header always unset Content-Security-Policy
Header unset Content-Security-Policy
</IfModule>

# Sem cache velho: a cada build o .js e o .wasm têm o mesmo nome; um .js velho guardado
# (navegador ou Cloudflare) com o .wasm novo quebra o editor. "no-cache" = o navegador
# confere com o servidor (resposta 304, sem baixar de novo se não mudou).
<IfModule mod_headers.c>
<FilesMatch "\.(html|js|mjs|json|wasm|svg|png|webmanifest|css|exe)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
